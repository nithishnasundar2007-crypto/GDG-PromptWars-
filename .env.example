# Web app (apps/web) — Vite only exposes VITE_-prefixed variables to the
# browser bundle. That boundary is load-bearing: it's what keeps
# GEMINI_API_KEY out of the client (docs/PHASE0_AUDIT.md sections I/J).
VITE_USE_MOCKS=true
VITE_SCOPE=sprint
VITE_AI_PROXY_URL=http://localhost:8787
# Named RUNNER_TIMEOUT_MS in the Team Plan / brief; spelled with the VITE_
# prefix here so Vite actually exposes it to grading/runner (see
# apps/web/src/config/index.ts).
VITE_RUNNER_TIMEOUT_MS=8000
# Named without a VITE_ prefix in the Team Plan / brief; these two ARE
# VITE_-prefixed because grading/config.ts reads them via import.meta.env.
VITE_AI_TIMEOUT_MS=20000
VITE_RUNNER_TEST_TIMEOUT_MS=2000
VITE_RUNNER_TOTAL_TIMEOUT_MS=10000
# Public by design — an App Check site key is not a secret (docs/SECURITY.md).
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# AI proxy (apps/ai-proxy) — server-side only, never committed with real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787
RATE_LIMIT_PER_MIN=60
# App Check: real enforcement needs a live Firebase project this sandbox
# doesn't have (docs/SECURITY.md). Leave APP_CHECK_DEV_BYPASS=true for local
# dev; set it to "false" (and FIREBASE_PROJECT_ID) only against a real project.
APP_CHECK_DEV_BYPASS=true
FIREBASE_PROJECT_ID=
