# Web app (apps/web) — Vite only exposes VITE_-prefixed variables to the
# browser bundle. That boundary is load-bearing: it's what keeps
# GEMINI_API_KEY out of the client (docs/PHASE0_AUDIT.md sections I/J).
VITE_USE_MOCKS=true
VITE_SCOPE=sprint
VITE_AI_PROXY_URL=http://localhost:8787
# Named RUNNER_TIMEOUT_MS in the Team Plan / brief; spelled with the VITE_
# prefix here so Vite actually exposes it to grading/runner (see
# apps/web/src/config/index.ts).
VITE_RUNNER_TIMEOUT_MS=8000

# AI proxy (apps/ai-proxy) — server-side only, never committed with real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787
